---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import FinalCtaBand from '../components/FinalCtaBand.astro';
import about from '../data/about.json';
import site from '../data/site.json';
---

<BaseLayout
  title="About SHELLCAT — Mission, Vision, Values & Ethical Security | Kerala, India"
  description="Who we are, our mission, vision, core values and what makes SHELLCAT different in cybersecurity testing and software development."
  currentPath="/about"
>
  <section class="border-b border-border bg-shellcat-grid py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionLabel file="about.txt" />
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-mist sm:text-5xl">
        Who We Are
      </h1>
      <div class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed text-secondary sm:text-lg">
        {about.whoWeAre.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <p class="mt-6 font-mono text-xs text-muted">
        Concept: {site.concept} · Based in {site.location}
      </p>
    </div>
  </section>

  <section class="border-b border-border py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <article class="rounded-2xl border border-border bg-surface p-7 sm:p-8">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-lime">— OUR MISSION</p>
          <p class="mt-4 text-lg leading-relaxed text-mist">{about.mission}</p>
        </article>

        <article class="rounded-2xl border border-border bg-surface p-7 sm:p-8">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-lime">— OUR VISION</p>
          <p class="mt-4 text-lg leading-relaxed text-mist">{about.vision}</p>
        </article>
      </div>

      <div class="mt-14">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-lime">— OUR CORE VALUES</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {about.coreValues.map((val) => (
            <article class="rounded-2xl border border-border bg-surface p-5">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-border bg-night text-lime">
                <Icon name={val.icon} class="h-5 w-5" />
              </div>
              <h2 class="mt-4 text-base font-extrabold text-mist">{val.title}</h2>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-surface/30 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-lime">— WHY SHELLCAT</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
        What makes us different.
      </h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {about.differentiators.map((item) => (
          <article class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-border bg-night text-lime">
              <Icon name={item.icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-extrabold text-mist">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-secondary">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <SectionLabel file="founder.txt" />
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist">Founder</h2>

      <div class="mt-8 flex flex-col gap-6 rounded-2xl border border-border bg-surface p-6 sm:flex-row sm:items-center sm:p-8">
        <div
          class="flex h-28 w-28 shrink-0 items-center justify-center rounded-2xl border border-dashed border-lime/50 bg-night p-3 text-center font-mono text-xs text-lime"
          aria-label="Founder photo placeholder"
        >
          {site.founder.photoPlaceholder}
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">{site.founder.role}</p>
          <h3 class="mt-1 text-xl font-extrabold text-mist">
            <span class="placeholder-token">{site.founder.name}</span>
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-secondary">
            <span class="placeholder-token">{site.founder.bio}</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <FinalCtaBand />
</BaseLayout>
