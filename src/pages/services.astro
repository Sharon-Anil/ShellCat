---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import FinalCtaBand from '../components/FinalCtaBand.astro';
import services from '../data/cybersecurity-services.json';
import about from '../data/about.json';
import site from '../data/site.json';

const serviceSchemas = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.whatItIs,
  provider: {
    '@type': 'ProfessionalService',
    name: 'SHELLCAT',
    areaServed: 'Kerala, India',
  },
}));
---

<BaseLayout
  title="Cybersecurity Services — Penetration Testing, API & Cloud Security | SHELLCAT"
  description="Ten human-led cybersecurity services from SHELLCAT in Kerala, India: website VAPT, web application testing, API, network, cloud, mobile, red team, malware analysis, auditing and incident investigation."
  currentPath="/services"
  schemas={serviceSchemas}
>
  <section class="border-b border-border bg-shellcat-grid py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionLabel file="services.txt" />
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-mist sm:text-5xl">
        Our Cybersecurity Services
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-secondary sm:text-lg">
        We look for the weaknesses attackers look for, and help you fix them before anyone else finds them. Every engagement is authorised in writing before work starts.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/contact?service=SHELLCAT+WEB+CHECK+(Starting+at+₹10,000)"
          class="inline-flex items-center gap-2 rounded-xl bg-lime px-6 py-3.5 text-sm font-semibold text-night transition-colors hover:bg-lime-hover"
        >
          <span>Book a Web Check</span>
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-6 py-3.5 text-sm font-semibold text-mist transition-colors hover:border-lime/60 hover:text-lime"
        >
          <Icon name="whatsapp" class="h-4 w-4 text-lime" />
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <nav aria-label="Jump to service" class="mt-10 flex flex-wrap gap-2">
        {services.map((s) => (
          <a
            href={`#${s.slug}`}
            class="rounded-lg border border-border bg-surface px-3 py-1.5 font-mono text-xs text-secondary transition-colors hover:border-lime/60 hover:text-lime"
          >
            {s.number} {s.title}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-3">
        {about.stats.map((stat) => (
          <article class="rounded-2xl border border-border bg-surface p-6">
            <p class="font-display text-2xl font-extrabold text-lime sm:text-3xl">
              {stat.value}
              <sup class="ml-0.5 text-xs text-muted">{stat.footnote}</sup>
            </p>
            <p class="mt-2 text-sm text-secondary">{stat.description}</p>
          </article>
        ))}
      </div>
      <p class="mt-4 text-xs text-muted">{about.statsSource}</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      {services.map((service) => (
        <article
          id={service.slug}
          class="scroll-mt-24 rounded-2xl border border-border bg-surface p-6 sm:p-8 lg:p-10"
        >
          <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-border bg-night text-lime">
                <Icon name={service.icon} class="h-6 w-6" />
              </div>
              <div>
                <p class="font-mono text-xs text-lime">SERVICE {service.number}</p>
                <h2 class="mt-1 text-2xl font-extrabold text-mist sm:text-3xl">{service.title}</h2>
              </div>
            </div>

            <a
              href={`/contact?service=${encodeURIComponent(service.title)}`}
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-lime px-5 py-3 text-sm font-semibold text-night transition-colors hover:bg-lime-hover"
            >
              <span>Book this</span>
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>

          <div class="mt-8 grid gap-6 border-t border-border pt-6 md:grid-cols-3">
            <div>
              <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-lime">What it is</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-mist">{service.whatItIs}</p>
            </div>

            <div>
              <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-lime">Who it&apos;s for</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-secondary">{service.whoItIsFor}</p>
            </div>

            <div>
              <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-lime">What you receive</h3>
              <ul class="mt-2.5 space-y-2 text-sm text-secondary">
                {service.whatYouReceive.map((item) => (
                  <li class="flex items-start gap-2">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-lime" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <FinalCtaBand />
</BaseLayout>
