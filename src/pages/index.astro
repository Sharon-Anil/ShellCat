---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import TerminalHero from '../components/TerminalHero.astro';
import HeroRings from '../components/HeroRings.astro';
import Icon from '../components/Icon.astro';
import PricingCard from '../components/PricingCard.astro';
import FinalCtaBand from '../components/FinalCtaBand.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import services from '../data/cybersecurity-services.json';
import pricing from '../data/pricing.json';
import processData from '../data/how-we-work.json';
import faq from '../data/faq.json';

const previewSecurityPackages = pricing.securityPackages.slice(0, 2);
const shieldPlan = pricing.monthlyProtection.find((p) => p.slug === 'shellcat-shield')!;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="SHELLCAT — Cybersecurity Testing, Software Development & Digital Protection | Kerala, India"
  description="Human-led penetration testing (VAPT), secure software development and monthly website protection from SHELLCAT in Kerala, India. Clear starting prices and authorised testing."
  currentPath="/"
  schemas={[faqSchema]}
>
  <!-- 2. HERO -->
  <section class="relative overflow-hidden bg-shellcat-grid border-b border-border">
    <HeroRings class="absolute -right-24 -top-24 h-[520px] w-[520px] opacity-80 sm:-right-12 sm:-top-16 sm:h-[640px] sm:w-[640px]" />

    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-6">
          <SectionLabel file="mission.txt" />

          <h1 class="mt-5 text-4xl font-extrabold leading-[1.06] tracking-tight text-mist sm:text-5xl lg:text-6xl">
            Securing your <span class="text-lime">digital world.</span>
          </h1>

          <p class="mt-5 max-w-xl text-base leading-relaxed text-secondary sm:text-lg">
            Advanced cybersecurity services and intelligent software solutions designed to protect, develop and strengthen your digital infrastructure.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/contact?service=SHELLCAT+WEB+CHECK+(Starting+at+₹10,000)"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-lime px-6 py-3.5 text-sm font-semibold text-night transition-colors hover:bg-lime-hover"
            >
              <span>Book a Web Check</span>
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            <a
              href={site.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-surface px-6 py-3.5 text-sm font-semibold text-mist transition-colors hover:border-lime/60 hover:text-lime"
            >
              <Icon name="whatsapp" class="h-4 w-4 text-lime" />
              <span>Chat on WhatsApp</span>
            </a>
          </div>

          <p class="mt-6 font-mono text-xs text-muted">
            {site.location} · {site.tagline} · Clear starting prices from ₹10,000
          </p>
        </div>

        <div class="lg:col-span-6">
          <TerminalHero />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PILLARS STRIP -->
  <section aria-label="Core service pillars" class="border-b border-border bg-surface/60">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-xs tracking-[0.2em] text-secondary sm:justify-between">
        {site.pillars.map((pillar, idx) => (
          <li class="flex items-center gap-6">
            <span class="text-mist">{pillar}</span>
            {idx < site.pillars.length - 1 && (
              <span class="hidden text-lime sm:inline" aria-hidden="true">|</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. WHY IT MATTERS -->
  <section class="border-b border-border py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <SectionLabel file="why-it-matters.txt" />
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
          Why proactive security matters in India
        </h2>
        <p class="mt-3 text-base text-secondary">
          Finding and fixing gaps early costs far less than recovering after an incident or missing statutory safeguards.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {about.stats.map((stat) => (
          <article class="rounded-2xl border border-border bg-surface p-6 sm:p-7">
            <p class="font-display text-3xl font-extrabold text-lime sm:text-4xl">
              {stat.value}
              <sup class="ml-0.5 text-sm font-semibold text-muted">{stat.footnote}</sup>
            </p>
            <p class="mt-3 text-sm leading-relaxed text-secondary">{stat.description}</p>
          </article>
        ))}
      </div>

      <p class="mt-5 text-xs leading-relaxed text-muted">{about.statsSource}</p>
    </div>
  </section>

  <!-- 5. SERVICES GRID -->
  <section class="border-b border-border bg-surface/30 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <SectionLabel file="services.txt" />
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
            Our Cybersecurity Services
          </h2>
          <p class="mt-3 text-base text-secondary">
            We look for the weaknesses attackers look for, and help you fix them before anyone else finds them.
          </p>
        </div>

        <a
          href="/services"
          class="inline-flex items-center gap-2 text-sm font-semibold text-lime transition-colors hover:text-lime-hover"
        >
          <span>Explore full service details</span>
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-2">
        {services.map((service) => (
          <a
            href={`/services#${service.slug}`}
            class="group flex items-start gap-4 rounded-2xl border border-border bg-surface p-5 sm:p-6 transition-colors hover:border-lime/60"
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-night text-lime transition-colors group-hover:border-lime/50">
              <Icon name={service.icon} class="h-5 w-5" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-lg font-extrabold text-mist transition-colors group-hover:text-lime">
                  <span class="mr-2 font-mono text-xs text-lime">{service.number}</span>
                  {service.title}
                </h3>
                <Icon
                  name="arrow-right"
                  class="h-4 w-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-lime"
                />
              </div>
              <p class="mt-2 text-sm leading-relaxed text-secondary">{service.shortLine}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. WHY SHELLCAT -->
  <section class="border-b border-border py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <SectionLabel file="about.txt" />
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
          Why SHELLCAT: what makes us different
        </h2>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {about.differentiators.map((item) => (
          <article class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-border bg-night text-lime">
              <Icon name={item.icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-extrabold text-mist">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-secondary">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. HOW WE WORK -->
  <section class="border-b border-border bg-surface/30 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <SectionLabel file="process.txt" />
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
            How we work
          </h2>
          <p class="mt-3 text-base text-secondary">
            Clear stages from initial discovery through authorised testing, development and continuing protection.
          </p>
        </div>

        <a
          href="/how-we-work"
          class="inline-flex items-center gap-2 text-sm font-semibold text-lime transition-colors hover:text-lime-hover"
        >
          <span>Read our pre-test checklist</span>
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {processData.steps.map((step) => (
          <li class="rounded-2xl border border-border bg-surface p-5">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-lime/60 bg-night font-mono text-xs font-medium text-lime">
              {step.number}
            </span>
            <h3 class="mt-4 text-base font-extrabold tracking-wide text-mist">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-secondary">{step.description}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8 flex items-start gap-4 rounded-2xl border border-lime/35 bg-surface p-6">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-lime/40 bg-night text-lime">
          <Icon name="ethical" class="h-5 w-5" />
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-lime">
            {processData.assuranceLabel}
          </p>
          <p class="mt-1.5 text-sm leading-relaxed text-mist sm:text-base">
            {processData.assurance}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. PRICING PREVIEW -->
  <section class="border-b border-border py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <SectionLabel file="pricing.txt" />
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
            Clear starting prices
          </h2>
          <p class="mt-3 text-base text-secondary">
            Published starting rates so you can plan your budget before the first call.
          </p>
        </div>

        <a
          href="/pricing"
          class="inline-flex items-center gap-2 text-sm font-semibold text-lime transition-colors hover:text-lime-hover"
        >
          <span>See all pricing</span>
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {previewSecurityPackages.map((pkg) => (
          <PricingCard
            code={pkg.code}
            brandPrefix={pkg.brandPrefix}
            name={pkg.name}
            pricePrefix={pkg.pricePrefix}
            price={pkg.price}
            billing={pkg.billing}
            features={pkg.features}
            featured={pkg.featured}
            badge={pkg.badge}
            bookingValue={`${pkg.brandPrefix} ${pkg.name} (${pkg.pricePrefix} ${pkg.price})`}
          />
        ))}
        <PricingCard
          brandPrefix={shieldPlan.brandPrefix}
          name={shieldPlan.name}
          price={shieldPlan.price}
          priceSuffix={shieldPlan.priceSuffix}
          billing={shieldPlan.billing}
          features={shieldPlan.features}
          featured={shieldPlan.featured}
          badge={shieldPlan.badge}
          bookingValue="SHELLCAT SHIELD Monthly Protection (₹7,500/month)"
          ctaLabel="Start monthly protection"
        />
      </div>
    </div>
  </section>

  <!-- 9. MONTHLY PROTECTION BAND -->
  <section class="border-b border-border bg-surface/40 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <SectionLabel file="protection.txt" />
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
          Security isn&apos;t one-time.
        </h2>
        <p class="mt-3 text-base text-secondary">
          Websites, plugins and server settings change over time. Choose a monthly protection plan to keep uptime, SSL, backups and security checks running after launch.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {pricing.monthlyProtection.map((plan) => (
          <PricingCard
            brandPrefix={plan.brandPrefix}
            name={plan.name}
            price={plan.price}
            priceSuffix={plan.priceSuffix}
            billing={plan.billing}
            features={plan.features}
            featured={plan.featured}
            badge={plan.badge}
            bookingValue={`${plan.brandPrefix} ${plan.name} Monthly Protection (${plan.price}${plan.priceSuffix})`}
            ctaLabel={`Choose ${plan.name}`}
          />
        ))}
      </div>

      <div class="mt-6 flex flex-col gap-1 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>{pricing.monthlyNotes[0]}</p>
        <p><span class="placeholder-token">{pricing.monthlyNotes[1]}</span></p>
      </div>
    </div>
  </section>

  <!-- 10. DPDP BAND -->
  <section class="border-b border-border py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-border bg-surface p-8 sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-10">
        <div class="max-w-2xl">
          <SectionLabel file="dpdp.txt" />
          <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-mist sm:text-3xl">
            Prepare for India&apos;s DPDP Act before 13 May 2027
          </h2>
          <p class="mt-3 text-base leading-relaxed text-secondary">
            Most DPDP obligations—including taking reasonable security safeguards to protect personal data and reporting breaches—are scheduled to start on <strong class="text-mist">13 May 2027</strong>. Failing to keep reasonable security safeguards carries statutory penalties of up to ₹250 crore.
          </p>
          <p class="mt-3 text-xs text-muted">
            General technical information, not legal advice. Source: Digital Personal Data Protection Act, 2023, Schedule.
          </p>
        </div>

        <div class="mt-6 shrink-0 lg:mt-0">
          <a
            href="/dpdp-readiness"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-lime px-6 py-3.5 text-sm font-semibold text-night transition-colors hover:bg-lime-hover"
          >
            <span>Check your readiness</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="py-16 sm:py-20" id="faq">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <SectionLabel file="faq.txt" />
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
        Frequently asked questions
      </h2>
      <p class="mt-3 text-base text-secondary">
        Plain-language answers on penetration testing, safety, pricing and monthly protection.
      </p>

      <div class="mt-10 divide-y divide-border rounded-2xl border border-border bg-surface">
        {faq.map((item, idx) => (
          <details class="group p-5 sm:p-6" open={idx === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-semibold text-mist hover:text-lime">
              <span>{item.question}</span>
              <Icon
                name="chevron-down"
                class="h-5 w-5 shrink-0 text-lime transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 pr-6 text-sm leading-relaxed text-secondary sm:text-base">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. FINAL CALL TO ACTION -->
  <FinalCtaBand />
</BaseLayout>
