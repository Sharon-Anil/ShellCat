---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="404 — Page Not Found | SHELLCAT"
  description="The requested page could not be found on SHELLCAT."
  currentPath="/404"
  noindex={true}
>
  <section class="bg-shellcat-grid py-20 sm:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-border bg-surface p-6 sm:p-10">
        <div class="flex items-center gap-2 border-b border-border pb-4 font-mono text-xs text-muted">
          <img
            src="/logos/shellcat-icon-on-dark.svg"
            alt=""
            width="14"
            height="18"
            class="h-4 w-auto"
            aria-hidden="true"
          />
          <span>shellcat — bash</span>
        </div>

        <div class="mt-6 font-mono text-sm leading-7">
          <p><span class="text-lime mr-2">$</span><span class="text-secondary">cat requested-page.txt</span></p>
          <p class="text-mist">cat: requested-page.txt: No such file or directory (HTTP 404)</p>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
          Page not found
        </h1>
        <p class="mt-3 text-base text-secondary">
          The page you requested may have moved or the URL may contain a typo.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-xl bg-lime px-5 py-3 text-sm font-semibold text-night transition-colors hover:bg-lime-hover"
          >
            <span>Return to Home</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a
            href="/services"
            class="rounded-xl border border-border bg-night px-5 py-3 text-sm font-semibold text-mist hover:border-lime/60 hover:text-lime"
          >
            Cybersecurity Services
          </a>
          <a
            href="/pricing"
            class="rounded-xl border border-border bg-night px-5 py-3 text-sm font-semibold text-mist hover:border-lime/60 hover:text-lime"
          >
            Pricing
          </a>
          <a
            href="/contact"
            class="rounded-xl border border-border bg-night px-5 py-3 text-sm font-semibold text-mist hover:border-lime/60 hover:text-lime"
          >
            Book a Web Check
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
