---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import FinalCtaBand from '../components/FinalCtaBand.astro';
import processData from '../data/how-we-work.json';
---

<BaseLayout
  title="How We Work — Authorised Security Testing & Software Process | SHELLCAT"
  description="Our five-stage cybersecurity and software process, written authorisation rules of engagement, and pre-test readiness checklist."
  currentPath="/how-we-work"
>
  <section class="border-b border-border bg-shellcat-grid py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionLabel file="process.txt" />
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-mist sm:text-5xl">
        How We Work
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-secondary sm:text-lg">
        Structured, transparent and strictly authorised from the first discovery call through testing, reporting and continuing support.
      </p>
    </div>
  </section>

  <section class="border-b border-border py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-5">
        {processData.steps.map((step) => (
          <li class="rounded-2xl border border-border bg-surface p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-lime/60 bg-night font-mono text-sm font-semibold text-lime">
              {step.number}
            </span>
            <h2 class="mt-5 text-lg font-extrabold tracking-wide text-mist">{step.title}</h2>
            <p class="mt-2.5 text-sm leading-relaxed text-secondary">{step.description}</p>
          </li>
        ))}
      </ol>

      <div class="mt-10 rounded-2xl border border-lime/40 bg-surface p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-lime/40 bg-night text-lime">
            <Icon name="ethical" class="h-6 w-6" />
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-lime">
              {processData.assuranceLabel}
            </p>
            <p class="mt-2 text-base leading-relaxed text-mist sm:text-lg">
              {processData.assurance}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <SectionLabel file="before-we-test.txt" />
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-mist sm:text-4xl">
        Before we test checklist
      </h2>
      <p class="mt-3 text-base text-secondary">
        We confirm all five items below before running any active security test on your website, application or network.
      </p>

      <ul class="mt-8 space-y-4">
        {processData.beforeWeTest.map((row, idx) => (
          <li class="flex items-start gap-4 rounded-2xl border border-border bg-surface p-5 sm:p-6">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-lime/50 bg-night text-lime">
              <Icon name="check" class="h-5 w-5" />
            </div>
            <div>
              <h3 class="text-lg font-extrabold text-mist">
                <span class="mr-2 font-mono text-xs text-lime">0{idx + 1}</span>
                {row.item}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-secondary">{row.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCtaBand />
</BaseLayout>
