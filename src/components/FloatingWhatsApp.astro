---
import site from '../data/site.json';
import Icon from './Icon.astro';
---

<a
  href={site.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp with SHELLCAT"
  class="fixed bottom-4 right-4 z-40 inline-flex items-center gap-2.5 rounded-full border border-lime/65 bg-surface/95 px-4 py-3 text-sm font-semibold text-mist shadow-xl backdrop-blur-md transition-colors hover:border-lime hover:bg-surface-elevated"
>
  <Icon name="whatsapp" class="h-5 w-5 text-lime" />
  <span class="hidden sm:inline">Chat on WhatsApp</span>
</a>
