---
import site from '../data/site.json';
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';
---

<section class="border-t border-border bg-surface/50 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-2xl border border-border bg-surface p-8 sm:p-12">
      <div class="max-w-3xl">
        <SectionLabel file="engage.txt" />
        <h2 class="mt-4 text-3xl font-extrabold uppercase tracking-tight text-mist sm:text-4xl lg:text-5xl">
          LET&apos;S SECURE <span class="text-lime">WHAT YOU BUILD.</span>
        </h2>
        <p class="mt-4 max-w-2xl text-base text-secondary sm:text-lg">
          Contact SHELLCAT to discuss your cybersecurity testing, website or custom software build, and monthly protection requirements.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="/contact?service=SHELLCAT+WEB+CHECK+(Starting+at+₹10,000)"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-lime px-6 py-3.5 text-sm font-semibold text-night transition-colors hover:bg-lime-hover"
          >
            <span>Book a Web Check</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-night px-6 py-3.5 text-sm font-semibold text-mist transition-colors hover:border-lime/60 hover:text-lime"
          >
            <Icon name="whatsapp" class="h-4 w-4 text-lime" />
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
