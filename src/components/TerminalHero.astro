---
const lines = [
  { kind: 'cmd', prompt: '$', text: 'cat mission.txt' },
  { kind: 'out', text: 'Securing your digital world.' },
  { kind: 'cmd', prompt: '$', text: './engage --scope=agreed --authorised' },
  { kind: 'status', tag: '[+]', label: 'written authorisation ......', state: 'confirmed' },
  { kind: 'status', tag: '[+]', label: 'rules of engagement ........', state: 'defined' },
  { kind: 'status', tag: '[+]', label: 'security testing ...........', state: 'in progress' },
];
---

<div
  class="relative rounded-xl border border-border bg-surface/95 shadow-2xl overflow-hidden backdrop-blur-sm"
  data-hero-terminal
>
  <div class="flex items-center justify-between border-b border-border bg-night/80 px-4 py-3">
    <div class="flex items-center gap-2" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
    </div>
    <div class="flex items-center gap-2 font-mono text-xs text-muted">
      <img
        src="/logos/shellcat-icon-on-dark.svg"
        alt=""
        width="14"
        height="18"
        class="h-4 w-auto"
        aria-hidden="true"
      />
      <span>shellcat — bash</span>
    </div>
    <span class="font-mono text-[11px] uppercase tracking-wider text-lime/80">authorised</span>
  </div>

  <div class="p-5 sm:p-6 font-mono text-xs sm:text-[13px] leading-7 text-secondary space-y-1">
    {lines.map((line, index) => (
      <div class="terminal-line" data-terminal-line={index}>
        {line.kind === 'cmd' && (
          <p>
            <span class="text-lime font-medium mr-2">{line.prompt}</span>
            <span class="text-secondary" data-terminal-text={line.text}>{line.text}</span>
          </p>
        )}
        {line.kind === 'out' && (
          <p class="text-mist font-medium" data-terminal-text={line.text}>{line.text}</p>
        )}
        {line.kind === 'status' && (
          <p>
            <span class="text-lime mr-2">{line.tag}</span>
            <span class="text-secondary">{line.label} </span>
            <span class="text-mist">{line.state}</span>
          </p>
        )}
      </div>
    ))}
    <p class="pt-1 flex items-center gap-2" aria-hidden="true">
      <span class="text-lime">$</span>
      <span class="terminal-cursor"></span>
    </p>
  </div>
</div>

<script is:inline src="/scripts/terminal.js" defer></script>
